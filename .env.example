# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Model ─────────────────────────────────────────────────────────────────────
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
DEVICE=cpu          # set to 'cuda' if a GPU is available

# ── Scoring thresholds ────────────────────────────────────────────────────────
BLUR_THRESHOLD=80.0
EAR_THRESHOLD=0.20              # Eye Aspect Ratio: below this = closed eye
DUPLICATE_HASH_THRESHOLD=8      # pHash Hamming distance; lower = stricter dedup

# ── Batch config ──────────────────────────────────────────────────────────────
CLIP_BATCH_SIZE=8
SYNC_BATCH_LIMIT=200            # images above this count use async job processing

# ── Job store ─────────────────────────────────────────────────────────────────
JOB_TTL_SECONDS=3600            # in-memory job expiry (1 hour)
